{
  "name": "instantsearch/instantsearchplus",
  "description": "Search That Boosts Conversion: Fastest Semantic Search, Search Filters, and Search Autocomplete",
  "type": "magento2-module",
  "version": "4.91.54",
  "license": ["OSL-3.0"],
  "require": {
    "php": ">=7.1",
    "laminas/laminas-filter": ">=2.12.0",
    "laminas/laminas-http": ">=2.14.3"
  },
  "require-dev": {
    "magento-ecg/coding-standard": "^2.0",
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Autocompleteplus\\Autosuggest\\": ""
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
